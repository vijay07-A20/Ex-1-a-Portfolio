        <!-- ================= RIGHT SIDEBAR ================= -->

        <aside class="right-sidebar">

            <input
                class="search"
                type="text"
                placeholder="🔍  Search"
                onkeyup="searchPosts(this.value)"
            >

            <div class="right-card">

                <h2>What's happening</h2>

                <div class="trend">

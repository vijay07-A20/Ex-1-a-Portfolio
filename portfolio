                <span>Notifications</span>
            </div>

            <div class="menu-item">
                <span class="menu-icon">✉</span>
                <span>Messages</span>
            </div>

            <div class="menu-item">
                <span class="menu-icon">🔖</span>
                <span>Bookmarks</span>
            </div>

            <div class="menu-item">
                <span class="menu-icon">👤</span>
                <span>Profile</span>
            </div>

            <button class="post-btn" onclick="createPost()">
